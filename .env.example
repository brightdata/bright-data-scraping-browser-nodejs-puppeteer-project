# Bright Data scraping browser endpoint
# Copy this file to .env and replace the placeholders with your own values:
#   <customer_id>  your Bright Data customer ID (starts with hl_)
#   <zone_name>    the name of your Browser API zone
#   <password>     the password of that zone
# You can find all three in the Bright Data Control Panel, under your Browser API zone.
# Never commit your .env file or real credentials to the repository.
BRIGHT_DATA_SCRAPING_BROWSER_ENDPOINT=wss://brd-customer-<customer_id>-zone-<zone_name>:<password>@brd.superproxy.io:9222
